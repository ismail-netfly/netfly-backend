# NETFLY backend — copy to .env and fill real values. NEVER commit .env.
# No real secrets are in this file.

PORT=3000
NODE_ENV=development

# PostgreSQL connection string (e.g. from Neon / Supabase / Railway / VPS)
DATABASE_URL=postgres://user:password@localhost:5432/netfly

# Long random secret for JWT signing — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Allowed CORS origin for the web admin dashboard
CORS_ORIGIN=http://localhost:3001

# Google Sign-In (Android OAuth client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Google Play subscription verification (service account JSON path or contents)
# TODO: set up in Google Play Console + Google Cloud before enabling premium.
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
GOOGLE_PLAY_PACKAGE_NAME=com.netfly.app

# AdMob (see docs/MONETIZATION.md) — app IDs live in AndroidManifest / Info.plist
ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY

# Optional authorised metadata API (only if its terms permit commercial use)
# TMDB_API_KEY=YOUR_TMDB_API_KEY
